{
  "manifest_version": 3,
  "name": "Blink Catcher",
  "version": "1.1.0",
  "description": "Catches 1–3 frame inserts in Instagram Reels (hidden messages, '25th frame') and keeps them as full-size images.",
  "homepage_url": "https://github.com/angelus169/blink-catcher",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "detector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
